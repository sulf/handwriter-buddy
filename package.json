{
  "name": "handwriter-buddy",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node server/bridge.mjs",
    "app": "npm run build && electron .",
    "app:dev": "VITE_DEV=1 electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "hersheytext": "^2.0.0",
    "mqtt": "^5.15.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "main": "electron/main.mjs",
  "description": "Animated handwriting postcards, with A1 Mini pen plotting",
  "build": {
    "appId": "dev.sulf.handwriter-buddy",
    "productName": "Handwriter Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sulf",
        "repo": "handwriter-buddy",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulf/handwriter-buddy.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ulf Schwekendiek",
    "email": "sulf@me.com"
  }
}
